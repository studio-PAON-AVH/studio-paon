<?xml version="1.0"?>
<smp:binaryProc name="￼;XML￼" xmlns:sc="http://www.utc.fr/ics/scenari/v3/core" xmlns:smp="scenari.eu:builder:portal:1.0">
	<smp:identification code="xml"/>
	<smp:structure>
		<smp:path>
			<smp:pathLevel>
				<smp:fixedString value="FR-AVH-"/>
				<smp:meta sc:refUri="/portalLight/import/metas/isbn.meta"/>
			</smp:pathLevel>
		</smp:path>
		<smp:versionning>
			<smp:none/>
		</smp:versionning>
		<smp:metas>
			<smp:metaList info="identification">
				<smp:meta sc:refUri="/portalLight/import/metas/isbn.meta"/>
				<smp:meta sc:refUri="/portalLight/import/metas/uid.meta"/>
				<smp:meta sc:refUri="/portalLight/import/prc/xml/meta/sourceXMLDoctype.meta"/>
			</smp:metaList>
		</smp:metas>
	</smp:structure>
	<smp:writeProcess>
		<smp:buildMetas>
			<!--<smp:extractFromRootContent xmlns:smp="scenari.eu:builder:portal:1.0">
	<smp:extractByXsl sc:refUri="/portal/import/prc/xml/free/prc.xml.extractMetas.xsl" xmlns:sc="http://www.utc.fr/ics/scenari/v3/core">
		<smp:populatedMeta sc:refUri="/portal/import/prc/xml/meta/sourceXMLDoctype.meta"/>
	</smp:extractByXsl>
</smp:extractFromRootContent>-->
			<smp:metaToPopulate sc:refUri="/portalLight/import/metas/uid.meta">
				<smp:fixedString value="FR-AVH-"/>
				<smp:fromMeta sc:refUri="/portalLight/import/metas/isbn.meta"/>
			</smp:metaToPopulate>
		</smp:buildMetas>
		<smp:buildViews>
			<smp:infoView/>
			<smp:rootView code="xml" family="userFriendly" mimeType="application/xml" name="￼;Source￼">
				<smp:identityView/>
			</smp:rootView>
			<smp:freeView buildPath="lg2dtbook/build.xml" builtOn="content" code="dtbook" family="userFriendly" name="￼;DTBook￼" type="eu.scenari.store.service.mkviews.makers.AntViewMk" urlPatterns="?V=dtbook">
				<smp:condition sc:refUri="/portalLight/import/prc/xml/meta/islg.cond"/>
				<smp:resource sc:refUri="/portalLight/import/prc/xml/xmllg2dtbook.doss" toPath="lg2dtbook"/>
			</smp:freeView>
			<smp:view code="dtbook" family="userFriendly" name="￼;DTBook￼" urlPatterns="?V=dtbook">
				<smp:condition sc:refUri="/portalLight/import/prc/xml/meta/isdtbook.cond"/>
				<smp:identityView/>
			</smp:view>
			<smp:freeView buildPath="dtbook2dtmodel/build.xml" builtOn="views" code="dtmodel" family="userFriendly" fromCdView="dtbook" name="￼;DTModel￼" type="eu.scenari.store.service.mkviews.makers.AntViewMk" urlPatterns="?V=dtmodel">
				<smp:resource sc:refUri="/portalLight/import/prc/xml/dtbook2dtmodel.doss" toPath="dtbook2dtmodel"/>
			</smp:freeView>
		</smp:buildViews>
	</smp:writeProcess>
	<smp:authoring>
		<smp:preview>
			<smp:noContentWidget displayOnContentActions="true"/>
		</smp:preview>
		<smp:transformation label="￼;Archiver￼" sc:refUri="/portalLight/import/prc/archived/archived.processing"/>
	</smp:authoring>
</smp:binaryProc>
