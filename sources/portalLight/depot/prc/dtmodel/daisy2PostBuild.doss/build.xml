<?xml version="1.0" encoding="UTF-8"?>
<project name="importRes" basedir="." default="main">
	<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>
	<taskdef resource="net/sf/antcontrib/antlib.xml"/>
	<taskdef name="loadStaticClass" classname="com.scenari.scant.LoadStaticClass" onerror="ignore"/>
	<taskdef name="transformXsl" classname="com.scenari.m.co.ant.TransformXslTask"/>
	<taskdef name="transform" classname="com.scenari.m.co.ant.TransformTask"/>
	<taskdef name="aggregateZippedViews" classname="eu.scenari.editadapt.ant.AggregateZippedViewsTask"/>
	<taskdef name="splitSentencesBySpan" classname="eu.scenari.editadapt.ant.SplitSentencesBySpanTask"/>
	<taskdef name="customXsl" classname="eu.scenari.editadapt.ant.TransformXslTask"/>

	<property name="mode.debug" value="false"/>

	<target name="main">
		<!-- 1) Init post DAISY BUILD -->
		<!-- recup des fichiers du gen Daisy -->
		<copy todir="${vTmpDir}">
			<fileset dir="${vInput}" includes="*.html *.css"/>
		</copy>
		<!-- Mémorisation du fichier xhtml principal -->
		<first id="main">
			<fileset dir="${vTmpDir}" includes="*.html" excludes="ncc.html"/>
		</first>
		<basename property="main_html_file" file="${toString:main}"/>
		<!-- Recup et dezip des packages acapela (task ant free) -->
		<aggregateZippedViews filter="tts.zip" output="${vTmpDir}"/>

		<!-- 2) Construction/modifications des fichiers -->

		<!-- Déplacement des fichiers audio et xsl transf json -> xon -->
		<foreach target="post.acapela.unpackage" param="dir" inheritall="true" inheritrefs="true">
			<path>
				<dirset dir="${vTmpDir}" includes="*"/>
			</path>
		</foreach>
		<!-- split sentences (custom ant task) -->
		<splitSentencesBySpan inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/parsed_span.xml" sentencesSfx=".acapela.tts.zip.sentences.txt"/>
		<!-- add Ids-->
		<!-- Bug dans la fonction precedings... xsl remplacée par transformXsl remplacée par xslt -->
		<xslt in="${vTmpDir}/parsed_span.xml" out="${vTmpDir}/${main_html_file}" style="addIds.xsl">
			<param name="dPfx" expression="d"/>
			<param name="pPfx" expression="p"/>
			<param name="sPfx" expression="s"/>
		</xslt>


		<for param="xon">
			<path>
				<fileset dir="${vTmpDir}" includes="**/events.xon"/>
			</path>
			<sequential>
				<propertyregex override="yes" property="package" input="@{xon}" regexp=".+[\\/]([^\\/]+).acapela.tts.zip[\\/].+" replace="\1"/>
				<customXsl inFile="@{xon}" outFile="${vTmpDir}/${package}.tmp.smil" style="makeSmil.xsl">
					<param name="main_html_file" expression="${main_html_file}"/>
					<param name="package" expression="${package}"/>

					<param name="dPfx" expression="d"/>
					<param name="pPfx" expression="p"/>
					<param name="sPfx" expression="s"/>
				</customXsl>
			</sequential>
		</for>

		<!-- master.smil -->
		<customXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/master.tmp.smil" style="makeSmilMaster.xsl">
			<param name="dPfx" expression="d"/>
			<param name="sPfx" expression="s"/>
		</customXsl>
		<xslt in="${vTmpDir}/master.tmp.smil" out="${vTmpDir}/master.smil" style="post.smil.xsl"/>

		<for param="tmpSmil">
			<path>
				<fileset dir="${vTmpDir}" includes="*.tmp.smil"/>
			</path>
			<sequential>
				<propertyregex override="yes" property="package" input="@{tmpSmil}" regexp=".+[\\/]([^\\/]+).tmp.smil" replace="\1"/>
				<customXsl inFile="@{tmpSmil}" outFile="${vTmpDir}/${package}.tmp1.smil" style="makeSmilEllapsed.xsl">
					<param name="main_html_file" expression="${main_html_file}"/>
					<param name="package" expression="${package}"/>

					<param name="dPfx" expression="d"/>
					<param name="pPfx" expression="p"/>
					<param name="sPfx" expression="s"/>
				</customXsl>
			</sequential>
		</for>

		<!-- Add total time to html files -->
		<transformXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/${main_html_file}" style="addTotalTimeMeta.xsl"/>
		<!-- Post découpage - ajout des ids nécessaires -->
		<!-- Construction du ncc -->
		<transformXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/ncc.tmp.html" style="ncc.xsl">
			<param name="dPfx" expression="d"/>
			<param name="pPfx" expression="p"/>
			<param name="sPfx" expression="s"/>
		</transformXsl>
		<transformXsl inFile="${vTmpDir}/ncc.tmp.html" outFile="${vTmpDir}/ncc.tmp.html" style="filterSpan.ncc.xsl"/>
		<transformXsl inFile="${vTmpDir}/ncc.tmp.html" outFile="${vTmpDir}/ncc.tmp.html" style="post.ncc.xsl"/>

		<!-- FIXME: voir cette boucle peut être supprimé (passage du post.smil apres makeSmil) -->
		<for param="smil">
			<path>
				<fileset dir="${vTmpDir}" includes="*.tmp1.smil"/>
			</path>
			<sequential>
				<propertyregex override="yes" property="filename" input="@{smil}" regexp=".+[\\/]([^\\/]+).tmp1.smil" replace="\1"/>
				<!-- post traitement puis renommage des .tmp.smil en .smil  -->
				<xslt in="@{smil}" out="${vTmpDir}/${filename}.smil" style="post.smil.xsl"/>
			</sequential>
		</for>

		<!-- post xsl pour ajout du doctype -->
		<copy file="${vTmpDir}/${main_html_file}" tofile="${vTmpDir}/main.tmp.html"/>
		<xslt in="${vTmpDir}/main.tmp.html" out="${vTmpDir}/${main_html_file}" style="post.xhtml.xsl">
			<param name="cleanNccMeta" expression="true"/>
			<param name="clean4VoiceDream" expression="true"/>
		</xslt>
		<xslt in="${vTmpDir}/ncc.tmp.html" out="${vTmpDir}/ncc.html" style="post.xhtml.xsl"/>


		<!-- 3) Packaging -->

		<!-- rename -->
		<renameext srcDir="${vTmpDir}" fromExtension=".acapela.tts.zip.mp3" toExtension=".mp3" replace="true"/>
		<renameext srcDir="${vTmpDir}" fromExtension=".acapela.tts.zip.smil" toExtension=".smil" replace="true"/>
		<!-- clean up -->
		<delete includeEmptyDirs="true">
			<fileset dir="${vTmpDir}" includes="**/*.zip/ parsed_span.xml *.xon *.txt *.tmp.smil *.tmp1.smil  *.tmp.html"/>
		</delete>
		<!-- package -->
		<zip destfile="${vDestPath}" basedir="${vTmpDir}"/>
		<!-- clean up build dir -->
		<delete dir="${vTmpDir}"/>
	</target>

	<target name="post.acapela.unpackage">
		<basename property="dirName" file="${dir}"/>
		<!-- déplacement fichier audio -->
		<move file="${dir}/audio.mp3" tofile="${vTmpDir}/${dirName}.mp3"/>
		<!-- json2xon du fichier events -->
		<transform src="${dir}/events.json" dst="${dir}/events.xon" params="transform=json2xml"/>
		<transformXsl inFile="${dir}/events.xon" outFile="${vTmpDir}/${dirName}.sentences.txt" style="extractSentences.txt.xsl"/>
	</target>

</project>
