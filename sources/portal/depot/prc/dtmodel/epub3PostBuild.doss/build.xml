<?xml version="1.0" encoding="UTF-8"?>
<project name="importRes" basedir="." default="main">
	<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>
	<taskdef resource="net/sf/antcontrib/antlib.xml"/>
	<taskdef name="loadStaticClass" classname="com.scenari.scant.LoadStaticClass" onerror="ignore"/>
	<taskdef name="transformXsl" classname="com.scenari.m.co.ant.TransformXslTask"/>
	<taskdef name="transform" classname="com.scenari.m.co.ant.TransformTask"/>
	<taskdef name="aggregateZippedViews" classname="eu.scenari.editadapt.ant.AggregateZippedViewsTask"/>
	<taskdef name="splitSentencesBySpan" classname="eu.scenari.editadapt.ant.SplitSentencesBySpanTask"/>
	<taskdef name="customXsl" classname="eu.scenari.editadapt.ant.TransformXslTask"/>

	<property name="mode.debug" value="false"/>

	<target name="main">
		<!-- 1) Init post Epub 3 Build -->
		<!-- recup des fichiers du gen Epub3 -->
		<copy todir="${vTmpDir}">
			<fileset dir="${vInput}" includes="*.xhtml"/>
		</copy>
		<!-- Mémorisation du fichier xhtml principal -->
		<first id="main">
			<fileset dir="${vTmpDir}" includes="*.xhtml"/>
		</first>
		<basename property="main_html_file" file="${toString:main}"/>
		<!-- Recup et dezip des packages acapela (task ant free) -->
		<aggregateZippedViews filter="tts.zip" output="${vTmpDir}"/>


		<!-- 2) Construction/modifications des fichiers -->
		<!-- Déplacement des fichiers audio et xsl transf json -> xon -->
		<foreach target="post.acapela.unpackage" param="dir" inheritall="true" inheritrefs="true">
			<path>
				<dirset dir="${vTmpDir}" includes="*"/>
			</path>
		</foreach>
		<!-- split sentences (custom ant task) -->
		<splitSentencesBySpan inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/parsed_span.xml" sentencesSfx=".acapela.tts.zip.sentences.txt" parser="epub3"/>

		<!-- add Ids-->
		<!-- Bug dans la fonction precedings... transformXsl remplacée par xslt -->
		<xslt in="${vTmpDir}/parsed_span.xml" out="${vTmpDir}/${main_html_file}" style="addIds.xsl">
			<param name="dPfx" expression="d"/>
			<param name="pPfx" expression="p"/>
			<param name="sPfx" expression="s"/>
		</xslt>

		<!-- inject TS in span.sentence -->
		<customXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/${main_html_file}" style="addTS.xsl">
			<param name="dPfx" expression="d"/>
			<param name="sPfx" expression="s"/>
		</customXsl>

		<!-- note post process -->
		<customXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/${main_html_file}" style="post.xhtml.notes.xsl">
			<param name="dPfx" expression="d"/>
			<param name="sPfx" expression="s"/>
		</customXsl>

		<!-- Calcul de page coté contenu pour indiquer les pagebreak -->
		<customXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/${main_html_file}" style="post.xhtml.pages.xsl">
			<param name="dPfx" expression="d"/>
			<param name="sPfx" expression="s"/>
		</customXsl>

		<!-- package OPF -->
		<customXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/package.opf" style="makePackage.xsl">
			<param name="dPfx" expression="d"/>
			<param name="sPfx" expression="s"/>
		</customXsl>

		<for param="mp3">
			<path>
				<fileset dir="${vTmpDir}" includes="*.mp3"/>
			</path>
			<sequential>
				<propertyregex override="yes" property="package_id" input="@{mp3}" regexp=".+[\\/]([^\\/]+).acapela.tts.zip.mp3" replace="\1"/>
				<transformXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/${package_id}.smil" style="makeSmil.xsl">
					<param name="package_id" expression="${package_id}"/>
					<param name="dPfx" expression="d"/>
					<param name="pPfx" expression="p"/>
					<param name="sPfx" expression="s"/>
				</transformXsl>

				<transformXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/${package_id}.xhtml" style="makeXhtml.xsl">
					<param name="package_id" expression="${package_id}"/>
					<param name="dPfx" expression="d"/>
					<param name="pPfx" expression="p"/>
					<param name="sPfx" expression="s"/>
				</transformXsl>
			</sequential>
		</for>

		<!-- Construction du ncx -->
		<transformXsl inFile="${vTmpDir}/${main_html_file}" outFile="${vTmpDir}/nav.xhtml" style="makeNav.xsl">
			<param name="dPfx" expression="d"/>
			<param name="pPfx" expression="p"/>
			<param name="sPfx" expression="s"/>
		</transformXsl>

		<transformXsl inFile="${vTmpDir}/nav.xhtml" outFile="${vTmpDir}/nav.tmp.xhtml" style="filterPages.nav.xsl"/>
		<xslt in="${vTmpDir}/nav.tmp.xhtml" out="${vTmpDir}/nav.xhtml" style="post.nav.xsl"/>


		<!-- 3) Packaging -->
		<!-- rename -->
		<renameext srcDir="${vTmpDir}" fromExtension=".acapela.tts.zip.mp3" toExtension=".mp3" replace="true"/>
		<!-- clean up -->
		<delete includeEmptyDirs="true">
			<fileset dir="${vTmpDir}" includes="**/*.zip/ parsed_span.xml ${main_html_file} *.xon *.txt *.tmp.*"/>
		</delete>
		<!-- create epub directories -->
		<mkdir dir="${vTmpDir}/EPUB"/>
		<mkdir dir="${vTmpDir}/META-INF"/>
		<move todir="${vTmpDir}/EPUB">
      <fileset dir="${vTmpDir}" includes="*.mp3 *.smil *.xhtml *.opf"/>
    </move>

    <copy file="static/container.xml" tofile="${vTmpDir}/META-INF/container.xml"/>

		<!-- package -->
		<zip destfile="${vDestPath}" basedir="${vTmpDir}"/>
		<!-- Le fichier mimetype doit être positionné en premier dans l'index du zip -->
		<zip destfile="${vDestPath}" basedir="static" includes="mimetype" zip64Mode="never" update="true" keepcompression="true" compress="false"/>
		<!-- clean up build dir -->
		<delete dir="${vTmpDir}"/>
	</target>

	<target name="post.acapela.unpackage">
		<basename property="dirName" file="${dir}"/>
		<!-- déplacement fichier audio -->
		<move file="${dir}/audio.mp3" tofile="${vTmpDir}/${dirName}.mp3"/>
		<!-- json2xon du fichier events -->
		<transform src="${dir}/events.json" dst="${dir}/events.xon" params="transform=json2xml"/>
		<transformXsl inFile="${dir}/events.xon" outFile="${vTmpDir}/${dirName}.sentences.txt" style="extractSentences.txt.xsl"/>
	</target>

</project>
