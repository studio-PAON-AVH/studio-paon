			<call path="/*[local-name()='html']/*[local-name()='body']/*[local-name()='div']">
				<param name="id" path="substring(@id,2)"/>
				<param name="text" path="text()"/>
				<actions>
					&lt;!&ndash; Création fichiers txt &ndash;&gt;
					<echo file="${vFolderDest}/@{id}.txt" append="false">@{text}</echo>
					&lt;!&ndash; TTS &ndash;&gt;
					&lt;!&ndash; Commenter cette ligner pour debug dans builder sans ajout free du transformer acapelaTTS &ndash;&gt;
					&lt;!&ndash;<transform src="${vFolderDest}/@{id}.txt" dst="${vFolderDest}/@{id}.acapela.tts.zip" params="transform=acapelaTTS&amp;voice=Manon22k_HQ&amp;dico=Dictionnaire_MANON_AVH.dic"/>&ndash;&gt;
				</actions>
			</call>
		</xmltask>-->

		<!-- construction de l'index des vues -->
		<transformXsl inFile="${vFolderDest}/txts.xml" outFile="${vFolderDest}/index.xml" style="buildIndex.xsl"/>
